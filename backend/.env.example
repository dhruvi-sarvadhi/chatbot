# ── Which provider the backend talks to: "claude" or "openai" ───────────────
LLM_PROVIDER=claude

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini   # a chat model — not gpt-4o-transcribe/tts

# ── Generation settings ─────────────────────────────────────────────────────
SYSTEM_PROMPT=You are a friendly, concise assistant. Answer clearly and use short paragraphs or bullet points.
MAX_TOKENS=2048
# Claude only: low | medium | high | xhigh | max  (lower = faster + cheaper)
EFFORT=low

# ── Server ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
