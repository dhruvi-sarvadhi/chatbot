# ── Which provider the backend talks to: "claude" or "openai" ───────────────
LLM_PROVIDER=claude

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini   # a chat model — not gpt-4o-transcribe/tts

# ── Generation settings ─────────────────────────────────────────────────────
SYSTEM_PROMPT=You are a friendly, concise assistant. Answer clearly and use short paragraphs or bullet points.
MAX_TOKENS=2048
# Claude only: low | medium | high | xhigh | max  (lower = faster + cheaper)
EFFORT=low

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Where conversations, messages and per-turn metrics are stored. The backend
# creates the database and its tables on first start if they do not exist.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres@localhost:5433/chatbot
# Log every SQL statement — noisy, but useful when a query misbehaves.
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# false = run with no database at all: the chat answers, nothing is remembered.
PERSISTENCE_ENABLED=true

# ── Server ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Web search (optional) ───────────────────────────────────────────────────
# Tavily is a search API built for LLMs. Leave empty to use DuckDuckGo, which
# needs no key. Get one at https://tavily.com
TAVILY_API_KEY=
